{"tafseer":{"id":"mufradat","name_en":"Quran Mufradat","name_ar":"مفردات القرآن","language":"arabic"},"surah":{"number":113,"ayahs":[{"ayah_number":1,"words":[{"word_number":1,"meaning":"فعل أمرٍ مِنْ قالَ يقولُ بمعنى تَكَلَّمْ. وأصل القول: معناه النطق بالكلام واللفظ به باللسان"},{"word_number":2,"meaning":"أعتَصِمُ وألُوذُ، وأَلتَجِئ، وأَتحصَّن، وأستجير"},{"word_number":3,"meaning":"الرب هو ‌المالك المربي المتصرف المدبر لخلقه كما يشاء على ما تقتضيه حكمته"},{"word_number":4,"meaning":"الصبحُ إذا بدأ ضوءه، وكلُّ ما انفلقَ عن شيءٍ كالصُّبحِ والحَبِّ والنَّوى"}]},{"ayah_number":2,"words":[{"word_number":1,"meaning":"حرف جر"},{"word_number":2,"meaning":"السوء والأذى"},{"word_number":3,"meaning":"اسم موصول بمعنى الذي"},{"word_number":4,"meaning":"أوجد على غير مثال سابق"}]},{"ayah_number":3,"words":[{"word_number":1,"meaning":"حرف جر"},{"word_number":2,"meaning":"السوء والأذى"},{"word_number":3,"meaning":"ليلٍ مُظلمٍ شديد الظلام"},{"word_number":4,"meaning":"ظرف يدل على الزمن المستقبل"},{"word_number":5,"meaning":"دخل وأقبل بظلامه"}]},{"ayah_number":4,"words":[{"word_number":1,"meaning":"حرف جر"},{"word_number":2,"meaning":"السوء والأذى"},{"word_number":3,"meaning":"النساء الساحرات اللاتي ينفخن فيما يَعْقِدن من عُقَدٍ بقصد السحر، والنَّفْثُ هو النَّفخُ بلا ريقٍ"},{"word_number":4,"meaning":"حرف جر يفيد الظرفية"},{"word_number":5,"meaning":"جمع عُقدَةٍ من الخيوط والحبال ونحوها"}]},{"ayah_number":5,"words":[{"word_number":1,"meaning":"حرف جر"},{"word_number":2,"meaning":"السوء والأذى"},{"word_number":3,"meaning":"هو الذي يتمنى زوال النعمة عن غيره"},{"word_number":4,"meaning":"ظرف يدل على الزمن المستقبل."},{"word_number":5,"meaning":"إذا مارس الحسَدَ، وقام به بفعله أو بقوله أو بخواطره"}]}]}}