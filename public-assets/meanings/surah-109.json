{"tafseer":{"id":"mufradat","name_en":"Quran Mufradat","name_ar":"مفردات القرآن","language":"arabic"},"surah":{"number":109,"ayahs":[{"ayah_number":1,"words":[{"word_number":1,"meaning":"فعل أمرٍ مِنْ قالَ يقولُ بمعنى تَكَلَّمْ. وأصل القول: معناه النطق بالكلام واللفظ به باللسان"},{"word_number":2,"meaning":"يا: للنداء، أيها: وصلة لنداء ما فيه\"أل\"من الذكور مع التنبيه."},{"word_number":3,"meaning":"الجاحدون لله وما أنزل."}]},{"ayah_number":2,"words":[{"word_number":1,"meaning":"نافية غير عاملة."},{"word_number":2,"meaning":"لا أعبد: لا أنقاد ولا أخضع."},{"word_number":3,"meaning":"يحتمل أن تكون موصولة أو مصدرية."},{"word_number":4,"meaning":"ما تعبدون: الأصنام والآلهة الزائفة التي تنقادون وتخضعون لها."}]},{"ayah_number":3,"words":[{"word_number":1,"meaning":"لا: نافية غير عاملة."},{"word_number":2,"meaning":"ضمير رفع منفصل لجماعة المخاطبين."},{"word_number":3,"meaning":"طائعون."},{"word_number":4,"meaning":"يحتمل أن تكون موصولة أو مصدرية."},{"word_number":5,"meaning":"أطيع وأنقاد وأخضع."}]},{"ayah_number":4,"words":[{"word_number":1,"meaning":"لا: نافية غير عاملة."},{"word_number":2,"meaning":"ضمير رفع منفصل للمتكلم أو المتكلمة."},{"word_number":3,"meaning":"ولا أنا عابد ما عبدتم: وما أنا خاضع ولا مؤمن بما آمنتم به من الأصنام والآلهة الباطلة."},{"word_number":4,"meaning":"يحتمل أن تكون موصولة أو مصدرية."},{"word_number":5,"meaning":"ما عبدتم: المراد الأصنام والآلهة الباطلة."}]},{"ayah_number":5,"words":[{"word_number":1,"meaning":"لا: نافية غير عاملة."},{"word_number":2,"meaning":"ضمير رفع منفصل لجماعة المخاطبين."},{"word_number":3,"meaning":"طائعون."},{"word_number":4,"meaning":"يحتمل أن تكون موصولة أو مصدرية."},{"word_number":5,"meaning":"أنقاد وأخضع."}]},{"ayah_number":6,"words":[{"word_number":1,"meaning":"اللام: حرف جر يفيد الإختصاص."},{"word_number":2,"meaning":"دينكم: شريعتكم وعبادتكم والمراد شرككم."},{"word_number":3,"meaning":"اللام: حرف جر يفيد الإختصاص."},{"word_number":4,"meaning":"أصلها ديني والمراد الاسلام."}]}]}}